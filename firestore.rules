rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E PERFIS MULTI-SISTEMAS (RSV & DIST)
    // =========================================================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca usuário pelo e-mail (chave primária do painel-crm)
    function hasUserByEmail() {
      return isAuthenticated() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email));
    }

    // Busca usuário pelo uid (fallback para autenticações baseadas em uid)
    function hasUserByUid() {
      return isAuthenticated() && request.auth.uid != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Dados do documento do usuário
    function getUserData() {
      return hasUserByEmail()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data
        : (hasUserByUid() ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data : {});
    }

    // Role geral / CRM (admin, revisor, editor, cadastro, leitor)
    function getRole() {
      let data = getUserData();
      return data.get('role', data.get('papel', 'none'));
    }

    // Superadministrador / Admin Geral
    function isAdmin() {
      let role = getRole();
      let data = getUserData();
      return role == 'admin' ||
        data.get('admin_geral', false) == true ||
        request.auth.token.get('admin', false) == true;
    }

    // Role específica do Painel de Projetos (DIST) com fallback para role do CRM
    function getRoleProjetos() {
      let data = getUserData();
      return data.get('role_projetos', getRole());
    }

    // Permissões CRM / Governança
    function canCreateCRM() {
      let role = getRole();
      return isAdmin() || role in ['admin', 'revisor', 'editor', 'cadastro'];
    }

    function canEditCRM() {
      let role = getRole();
      return isAdmin() || role in ['admin', 'revisor', 'editor'];
    }

    function canDeleteCRM() {
      let role = getRole();
      return isAdmin() || role in ['admin', 'revisor'];
    }

    // Permissões Painel de Projetos (DIST)
    function canReadProjetos() {
      let rp = getRoleProjetos();
      return isAdmin() || rp in ['admin', 'revisor', 'editor', 'cadastro', 'leitor'];
    }

    function canWriteProjetos() {
      let rp = getRoleProjetos();
      return isAdmin() || rp in ['admin', 'revisor', 'editor', 'cadastro'];
    }

    function canDeleteProjetos() {
      let rp = getRoleProjetos();
      return isAdmin() || rp in ['admin', 'revisor'];
    }

    // =========================================================================
    // USUÁRIOS E GESTÃO DE ACESSOS (/usuarios)
    // =========================================================================
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.token.email != null && request.auth.token.email == userId) || 
        request.auth.uid == userId
      );
    }

    // =========================================================================
    // MÓDULO 1: BASE CENTRAL CRM / RSV (Master: painel-crm)
    // =========================================================================

    // Contatos
    match /contatos/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_pessoa' in resource.data) || request.resource.data.id_pessoa == resource.data.id_pessoa
      );
    }

    // Entidades
    match /entidades/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_entidade' in resource.data) || request.resource.data.id_entidade == resource.data.id_entidade
      );
    }

    // Interações / Reuniões / Eventos
    match /interacoes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_interacao' in resource.data) || request.resource.data.id_interacao == resource.data.id_interacao
      );
    }

    // Registros / Presenças
    match /registros/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_registro' in resource.data) || request.resource.data.id_registro == resource.data.id_registro
      );
    }

    match /presencas/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && canEditCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
    }

    // Câmaras Temáticas
    match /camara_tematica/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_cam' in resource.data) || request.resource.data.id_cam == resource.data.id_cam
      );
    }

    // Eixos RSV
    match /eixos_psv/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_eixo' in resource.data) || request.resource.data.id_eixo == resource.data.id_eixo
      );
    }

    // Municípios
    match /municipios/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('cod_ibge' in resource.data) || request.resource.data.cod_ibge == resource.data.cod_ibge
      );
    }

    // Indicações das Câmaras Temáticas
    match /indicacoes_camara/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id_indicacao' in resource.data) || request.resource.data.id_indicacao == resource.data.id_indicacao
      );
    }

    // Comitê Gestor
    match /comite_gestor/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id' in resource.data) || request.resource.data.id == resource.data.id
      );
    }

    // Representação do Sistran
    match /representacao_sistran/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateCRM();
      allow delete: if isAuthenticated() && canDeleteCRM();
      allow update: if isAuthenticated() && canEditCRM() && (
        isAdmin() || !('id' in resource.data) || request.resource.data.id == resource.data.id
      );
    }

    // Agrupamentos (Contact Groups)
    match /agrupamentos/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || request.auth.token.email == request.resource.data.email_usuario
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || request.auth.token.email == resource.data.email_usuario
      );
    }

    // Histórico de Alterações do CRM (Audit Log)
    match /historico_alteracao/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // MÓDULO 2: GESTÃO DE PROJETOS E ACOMPANHAMENTO DIST (Master: painel-projetos)
    // =========================================================================

    // Projetos
    match /projetos/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow create: if isAuthenticated() && canWriteProjetos();
      allow delete: if isAuthenticated() && canDeleteProjetos();
      allow update: if isAuthenticated() && canWriteProjetos() && (
        isAdmin() || !('id_projeto' in resource.data) || !('id_projeto' in request.resource.data) ||
        request.resource.data.id_projeto == resource.data.id_projeto
      );
    }

    // Diagnósticos DIST
    match /diagnosticos/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow write: if isAuthenticated() && canWriteProjetos();
    }

    // Matriz de Riscos
    match /riscos/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow write: if isAuthenticated() && canWriteProjetos();
    }

    match /riscos_projeto/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow write: if isAuthenticated() && canWriteProjetos();
    }

    // Histórico / Auditoria do Painel de Projetos
    match /historico/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow create: if isAuthenticated() && canWriteProjetos();
      allow update, delete: if false; // Auditoria imutável
    }

    match /audit_logs/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow create: if isAuthenticated() && canWriteProjetos();
      allow update, delete: if false;
    }

    // =========================================================================
    // MÓDULO 3: GESTÃO DE CONVITES & EVENTOS (Futuro Módulo)
    // =========================================================================
    match /convites/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow write: if isAuthenticated() && canWriteProjetos();
    }

    match /eventos/{docId} {
      allow read: if isAuthenticated() && canReadProjetos();
      allow write: if isAuthenticated() && canWriteProjetos();
    }

    // =========================================================================
    // BLOQUEIO GERAL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
